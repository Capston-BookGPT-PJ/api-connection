<!-- fragment_group_goal_setting.xml -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/group_goal_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/round_background_15"
    android:padding="16dp"
    android:layout_margin="12dp">

        <!-- 제목 -->
        <TextView
            android:id="@+id/group_reading_goal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="그룹 독서 목표"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/textColor"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/group_arrow"
            app:layout_constraintBottom_toTopOf="@+id/goal_books"
            android:layout_marginBottom="16dp"
            android:layout_marginLeft="10dp"/>

        <!-- 화살표 아이콘 -->
        <ImageView
            android:id="@+id/group_arrow"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/arrow"
            app:layout_constraintTop_toTopOf="@id/group_reading_goal"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- 목표 1 텍스트 -->
        <TextView
            android:id="@+id/goal_books"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="목표 권수"
            android:textColor="@color/textColor"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toBottomOf="@id/group_reading_goal"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginLeft="10dp"/>

        <!-- 목표 1 Progress -->
        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:id="@+id/progress_books"
            android:layout_width="0dp"
            android:layout_height="15dp"
            android:progress="66"
            android:max="100"
            android:progressDrawable="@drawable/goal_1"
            app:layout_constraintTop_toBottomOf="@id/goal_books"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>

        <!-- 목표 1 수치 -->
        <TextView
            android:id="@+id/group_goal_text1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2권/3권"
            android:textSize="12sp"
            android:textColor="@color/textColor"
            app:layout_constraintTop_toBottomOf="@id/progress_books"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="2dp"
            android:layout_marginRight="6dp"/>

        <!-- 목표 2 텍스트 -->
        <TextView
            android:id="@+id/goal_reviews"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="목표 감상문"
            android:textColor="@color/textColor"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/progress_books"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="10dp"/>

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:id="@+id/progress_reviews"
            android:layout_width="0dp"
            android:layout_height="15dp"
            android:progress="33"
            android:max="100"
            android:progressDrawable="@drawable/goal_2"
            app:layout_constraintTop_toBottomOf="@id/goal_reviews"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/group_goal_text2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1개/3개"
            android:textSize="12sp"
            android:textColor="@color/textColor"
            app:layout_constraintTop_toBottomOf="@id/progress_reviews"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="2dp"
            android:layout_marginRight="6dp"/>

        <!-- 목표 3 텍스트 -->
        <TextView
            android:id="@+id/group_goal_title3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="목표 시간"
            android:textColor="@color/textColor"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/progress_reviews"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="10dp"/>

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:id="@+id/progress_time"
            android:layout_width="0dp"
            android:layout_height="15dp"
            android:progress="30"
            android:max="100"
            android:progressDrawable="@drawable/goal_3"
            app:layout_constraintTop_toBottomOf="@id/group_goal_title3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/goal_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4.5시간/15시간"
            android:textSize="12sp"
            android:textColor="@color/textColor"
            app:layout_constraintTop_toBottomOf="@id/progress_time"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="2dp"
            android:layout_marginRight="6dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
